# Mapbox
PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Supabase (แอป)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase CLI / MCP (ไม่ commit — ดู .env.supabase)
# SUPABASE_ACCESS_TOKEN=your_personal_access_token

# Supabase CLI / MCP — สร้างไฟล์ .env.supabase (ไม่ commit)
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# ปลูกสร้าง login / register API
PUBLIC_PLUKSANG_LOGIN_URL=https://api.kasetkorn.app/login
# optional — defaults to same host with /create
# PUBLIC_PLUKSANG_CREATE_URL=https://api.kasetkorn.app/create
